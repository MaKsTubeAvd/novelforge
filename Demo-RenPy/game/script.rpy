    with dissolve
    $ renpy.pause(2.0, hard=True)
    hide screen nf_composition
    return

label start:
    jump nfscene_arrival

label nfscene_arrival:
    scene expression Transform("assets/court_photo.png", xysize=(1280, 720), fit="cover")
    with dissolve
    play music "assets/gentle_loop.wav" loop fadein 1.5 volume 0.45
    play sound "assets/soft_bell.wav" noloop fadein 0.0 volume 0.5
    $ day = 1
    "День 1"
    show expression "assets/anime_woman.png" as nfchar_anna at Transform(xpos=1024, xanchor=0.5, ypos=720, yanchor=1.0, ysize=490, fit="contain")
    with dissolve
    anna "Привет! Сыграем в волейбол?"
    menu:
        "Конечно!":
            jump nfscene_play
        "Сначала познакомимся":
            jump nfscene_talk
    return
    return

label nfscene_talk:
    anna "Я Анна. Рада знакомству!"
    $ trust = trust + 1
    jump nfscene_play
    return

label nfscene_play:
    call screen nf_mini("Тренировка подачи", "volleyball", 5, 25.0)
    $ trust = _return
    if trust >= 3:
        jump nfscene_win
    else:
        jump nfscene_finish
    return

label nfscene_win:
    $ achievement.grant("FIRST_WIN")
    $ achievement.sync()
    $ renpy.notify("Первая победа")
    "Отличная команда!"
    call nf_credits
    return
    return

label nfscene_finish:
    "Продолжим тренировку завтра!"
    call nf_credits
    return
    return

